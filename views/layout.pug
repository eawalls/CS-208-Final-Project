doctype html
html(lang="en")
  head
    title Downtown Donuts
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel='stylesheet', href='/stylesheets/style.css')
  
  body
    header
      nav.nav-container
        // Left Side Links
        ul.nav-links.nav-left
          li: a(href="/") Home
          li: a(href="/menu") Menu
        
        // Centered Logo
        a.logo(href="/")
          img(src="/images/logo.png" alt="Downtown Donuts Logo")
        
        // Right Side Links
        ul.nav-links.nav-right
          li: a(href="/about") Our Story
          li: a(href="/comments") Community

    .grid-container
      main
        block content
      
      aside.sidebar
        h3 Order Now
        br
        ul
          li: a(href="https://www.ubereats.com") UberEats
          li: a(href="https://www.doordash.com") DoorDash
          li: a(href="https://www.grubhub.com") Grubhub

    footer
      p Downtown Donuts. Family-owned and operated since 1992.
