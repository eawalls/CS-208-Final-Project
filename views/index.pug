extends layout

block content
  section.hero
    .hero-content
      .hero-text
        h1 Freshly Glazed, Locally Loved.
        p Bringing a cozy, modern twist to the downtown community since 1992.
        .cta-buttons
          a.btn-primary(href="/menu") View Menu
      
      .hero-image
        img(src="/images/donut.png" alt="A variety of donuts")

  section.featured
    h2 Why Downtown Donuts?
    .grid-layout
      .card
        h3 Hand-Crafted
        p Every donut is made fresh daily with local ingredients.
      .card
        h3 Family Owned
        p A staple of the downtown community for over 30 years.
