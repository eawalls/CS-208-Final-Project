extends layout

block content
  section.comments-section
    h1 Customer Community
    p We love hearing from our donut family!
    
    // General error message
    if error
      p.error-message= error

    // Form for posting comments
    form(action="/comments" method="POST")
      // Customer name field
      .form-group
        label(for="name") Name:
        input(type="text" name="name" id="name" required maxlength="50")
      
      // Comment message field
      .form-group
        label(for="comment") Message:
        textarea(name="comment" id="comment" required maxlength="800" placeholder="Share your donut experience...")
      
      // Submit Comment
      button(type="submit") Post Comment

    hr

  section.comments-list
  // Check if the array exists and has items
  if comments && comments.length > 0
    each msg in comments
      article.comment-card
        h3= msg.name
        small= msg.timestamp
        p= msg.comment
    if comments.length >= 5
      .pagination-container
        a.btn-load-more(href=`/comments?limit=${nextLimit}`) Load More
  else
    p No comments yet. Be the first to share!

    